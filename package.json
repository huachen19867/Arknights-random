{
  "name": "arknights-operator-randomizer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:test": "node scripts/self-test.mjs",
    "data:prts": "node scripts/sync-prts.mjs",
    "data:prts:samples": "node scripts/check-prts-samples.mjs",
    "data:prts:recheck": "node scripts/sync-prts.mjs --recheck-portraits --recheck-skills --recheck-modules",
    "data:update:preview": "node scripts/update-operators.mjs",
    "data:update:preview:no-base": "node scripts/update-operators.mjs --skip-base",
    "data:base:preview": "node scripts/base-upsert.mjs",
    "data:base:skills:preview": "node scripts/base-upsert.mjs --update-skills",
    "data:base:skills:write": "node scripts/base-upsert.mjs --update-skills --write",
    "data:base:write": "node scripts/base-upsert.mjs --write",
    "data:base:export": "node scripts/base-export.mjs",
    "data:base:modules:init": "node scripts/base-init-modules.mjs",
    "data:base:modules:init:yes": "node scripts/base-init-modules.mjs --yes",
    "data:base:modules:preview": "node scripts/base-upsert.mjs --update-modules",
    "data:base:modules:write": "node scripts/base-upsert.mjs --update-modules --write",
    "data:base:modules:update": "node scripts/base-upsert.mjs --update-modules --update-module-existing --write",
    "analytics:dev": "wrangler dev --config workers/analytics/wrangler.jsonc",
    "analytics:test": "vitest run --config workers/analytics/vitest.config.ts",
    "analytics:typecheck": "tsc -p workers/analytics/tsconfig.json",
    "analytics:deploy": "wrangler deploy --config workers/analytics/wrangler.jsonc"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.1",
    "@cloudflare/workers-types": "^5.20260801.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10",
    "wrangler": "^4.118.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260730.1": true
  }
}
